{
  "name": "mrrcqa",
  "label": "MRRC QA",
  "description": "Run MRRC Quality Assurance on morning phantoms",
  "version": "1.5.4.20260304",
  "author": "Chan Moon",
  "maintainer": "Will Foran <foranw@upmc.edu>",
  "license": "GPL-3.0",
  "url": "https://github.com/NPACore/fw-mrrcqa",
  "source": "https://github.com/NPACore/fw-mrrcqa",
  "environment": {
    "FLYWHEEL": "/flywheel/v0",
    "SHLVL": "1",
    "container": "podman",
    "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
    "PWD": "/",
    "LD_LIBRARY_PATH": "/opt/matlabruntime/R2024a/runtime/glnxa64:/opt/matlabruntime/R2024a/bin/glnxa64:/opt/matlabruntime/R2024a/sys/os/glnxa64:/opt/matlabruntime/R2024a/sys/opengl/lib/glnxa64:/opt/matlabruntime/R2024a/extern/bin/glnxa64",
    "DEBIAN_FRONTEND": "noninteractive",
    "TZ": "Etc/UTC"
  },
  "custom": {
    "gear-builder": {
      "category": "qa",
      "image": "npac/mrrcqa-ml:1.5.4.20260304"
    },
    "flywheel": {
      "suite": "utility"
    }
  },
  "inputs": {
    "phantom_dicom": {
      "description": "phantom nifti file",
      "base": "file",
      "type": {
        "enum": [
          "archive"
        ]
      }
    },
    "key": {
      "base": "api-key"
    }
  },
  "config": {
    "write_db": {
      "description": "write snr to flywhele database?",
      "default": false,
      "type": "boolean"
    }
  },
  "command": "/flywheel/v0/run.py"
}
